{
  "name": "@zyrox/server",
  "version": "0.1.0",
  "description": "Zyrox server: delivery API, admin API, publishing, releases, experiments, functions, preview relay.",
  "type": "module",
  "files": [
    "src",
    "drizzle",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "zyrox-server": "./src/main.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@zyrox/core": "workspace:*",
    "@zyrox/protocol": "workspace:*",
    "@zyrox/skills": "workspace:*",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@types/ws": "8.18.2"
  }
}
