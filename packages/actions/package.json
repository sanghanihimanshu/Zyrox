{
  "name": "@zyrox/actions",
  "version": "0.1.0",
  "description": "Drive app UI from any backend: sheets, alerts, toasts, redirects and event-trigger rules for Zyrox apps. Zero dependencies; Node, Bun, Deno, edge.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema.json": "./ui-actions.schema.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./schema.json": "./ui-actions.schema.json"
    }
  },
  "files": [
    "dist",
    "ui-actions.schema.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@types/node": "26.6.4",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
