{
  "name": "@zyrox-examples/components",
  "version": "0.0.0",
  "private": true,
  "description": "Example components and documents. Copy and adapt; Zyrox ships no UI library.",
  "type": "module",
  "exports": {
    "./defs": "./src/defs.ts",
    "./documents": "./documents/index.ts",
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run && jest",
    "test:web": "vitest run",
    "test:native": "jest",
    "zyrox": "zyrox"
  },
  "dependencies": {
    "@zyrox/protocol": "workspace:*",
    "@zyrox/react": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "19.2.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "@babel/core": "7.29.7",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/react-native": "14.0.1",
    "jest": "29.7.0",
    "jsdom": "30.1.1",
    "test-renderer": "1.3.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "@zyrox/cli": "workspace:*",
    "@jest/globals": "29.7.0",
    "@types/node": "26.6.4",
    "@zyrox-examples/shop-api": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-native": ">=0.76"
  }
}
