{
  "zyrox": 1,
  "kind": "screen",
  "key": "shop-product",
  "title": "Product",
  "params": {
    "id": {
      "type": "string",
      "required": true
    }
  },
  "data": {
    "product": {
      "url": "/products/{{ params.id }}",
      "cache": 300,
      "mock": {
        "id": "banana",
        "name": "Robusta Banana",
        "unit": "6 pcs",
        "price": 49,
        "mrp": 60,
        "emoji": "🍌",
        "color": "#fef3c7",
        "eta": 8,
        "category": "fruits"
      }
    }
  },
  "root": {
    "id": "root",
    "type": "Screen",
    "children": [
      {
        "id": "loading",
        "type": "Text",
        "if": "{{ loading.product && !data.product }}",
        "props": {
          "text": "Loading…",
          "tone": "muted"
        }
      },
      {
        "id": "details",
        "type": "Stack",
        "if": "{{ data.product }}",
        "props": {
          "gap": "md"
        },
        "with": {
          "item": "{{ data.product }}"
        },
        "children": [
          {
            "id": "product-card",
            "type": "ProductCard",
            "props": {
              "name": "{{ item.name }}",
              "unit": "{{ item.unit }}",
              "price": "{{ item.price }}",
              "mrp": "{{ item.mrp }}",
              "emoji": "{{ item.emoji }}",
              "color": "{{ item.color }}",
              "eta": "{{ item.eta }}",
              "qty": "{{ app.cart.items[item.id] ?? 0 }}"
            },
            "on": {
              "add": [
                {
                  "do": "addToCart",
                  "productId": "{{ item.id }}",
                  "qty": 1,
                  "price": "{{ item.price }}"
                },
                {
                  "do": "track",
                  "event": "add_to_cart",
                  "props": {
                    "product": "{{ item.id }}",
                    "source": "product",
                    "price": "{{ item.price }}"
                  }
                }
              ],
              "remove": [
                {
                  "do": "removeFromCart",
                  "productId": "{{ item.id }}",
                  "qty": 1
                }
              ]
            },
            "a11y": {
              "label": "{{ item.name }}"
            }
          },
          {
            "id": "similar",
            "type": "Section",
            "meta": {
              "note": "A dynamic API derived from the first response: similar items from the product's category."
            },
            "props": {
              "screen": "sections/product-rail",
              "params": {
                "title": "More in this category",
                "api": "/collections/{{ item.category }}",
                "collection": "{{ item.category }}"
              }
            }
          }
        ]
      }
    ],
    "slots": {
      "footer": [
        {
          "id": "cart-bar",
          "type": "Button",
          "if": "{{ app.cart.count > 0 }}",
          "props": {
            "label": "{{ app.cart.count }} {{ app.cart.count == 1 ? 'item' : 'items' }} · {{ format.currency(app.cart.total, 'INR') }} · View cart"
          },
          "on": {
            "press": [
              {
                "do": "navigate",
                "to": "cart"
              }
            ]
          },
          "motion": {
            "enter": "slideUp",
            "exit": "fade"
          }
        }
      ]
    }
  }
}
