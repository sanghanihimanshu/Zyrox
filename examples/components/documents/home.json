{
  "zyrox": 1,
  "kind": "screen",
  "key": "home",
  "title": "Home",
  "data": {
    "feed": {
      "url": "/feed",
      "refresh": ["mount", "foreground"],
      "mock": {
        "greeting": "Good morning",
        "promos": [
          { "id": "a", "title": "Free shipping", "tone": "success" },
          { "id": "b", "title": "20% off caps", "tone": "primary" }
        ],
        "products": [
          {
            "id": "p1",
            "name": "Trail Shoe",
            "price": 129.5,
            "image": "https://picsum.photos/seed/p1/400/400"
          },
          { "id": "p2", "name": "Sock", "price": 9, "image": "https://picsum.photos/seed/p2/400/400" },
          { "id": "p3", "name": "Cap", "price": 19, "image": "https://picsum.photos/seed/p3/400/400" }
        ]
      }
    }
  },
  "root": {
    "id": "root",
    "type": "Screen",
    "props": { "title": "{{ t('home.title') }}" },
    "children": [
      {
        "id": "hello",
        "type": "Text",
        "props": { "text": "{{ data.feed.greeting }}, {{ app.user.name ?? 'friend' }}", "variant": "title" }
      },
      {
        "id": "promos",
        "type": "Stack",
        "props": { "direction": "row", "gap": "sm", "wrap": true },
        "children": [
          {
            "id": "promo",
            "type": "Badge",
            "repeat": { "each": "{{ data.feed.promos }}", "as": "promo", "key": "{{ promo.id }}" },
            "props": { "label": "{{ promo.title }}", "tone": "{{ promo.tone }}" }
          }
        ]
      },
      {
        "id": "products",
        "type": "List",
        "props": { "items": "{{ data.feed.products }}", "columns": "{{ device.width > 768 ? 3 : 2 }}" },
        "templates": {
          "item": {
            "id": "product-card",
            "type": "Card",
            "with": { "p": "{{ item }}" },
            "props": { "title": "{{ p.name }}", "subtitle": "{{ format.currency(p.price, 'USD') }}" },
            "children": [
              {
                "id": "product-image",
                "type": "Image",
                "props": { "src": "{{ p.image }}", "radius": "sm", "alt": "{{ p.name }}" }
              }
            ],
            "on": { "press": [{ "do": "navigate", "to": "product", "params": { "id": "{{ p.id }}" } }] }
          }
        }
      }
    ]
  }
}
